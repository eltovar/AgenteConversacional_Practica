# ========================================
# PLANTILLA DE CONFIGURACIÓN - Inmobiliaria Proteger
# ========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA commitees el archivo .env al repositorio
#
# ========================================

# OpenAI Configuration
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Application Settings (opcional)
# DEBUG=false
# LOG_LEVEL=INFO

# Redis Configuration (para persistencia de sesiones)
# URL completa de conexión a Redis (formato: redis://[[username]:[password]]@host:port/db)
# Para desarrollo local sin autenticación:
REDIS_URL=redis://localhost:6379/0
REDIS_PUBLIC_URL=redis://localhost:6379/0

# Tiempo de vida de sesiones en segundos (default: 86400 = 24 horas)
SESSION_TTL=86400

# PostgreSQL Configuration (para RAG con pgvector)
# URL completa de conexión a PostgreSQL (formato: postgresql://user:password@host:port/database)
# Railway proporciona DATABASE_URL automáticamente
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Credenciales individuales PostgreSQL (Railway las proporciona automáticamente)
PGHOST=caboose.proxy.rlwy.net
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password-here
PGDATABASE=railway

# Twilio Configuration (para WhatsApp)
# Obtén tus credenciales en: https://console.twilio.com
# 1. TWILIO_ACCOUNT_SID: Identificador de cuenta (empieza con "AC")
# 2. TWILIO_AUTH_TOKEN: Token de autenticación (panel de Console)
# 3. TWILIO_PHONE_NUMBER: Número de teléfono WhatsApp de origen (formato: +14155238886 o +573001234567)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14155238886

# ========================================
# SISTEMA DE SEGUIMIENTO AUTOMATICO
# ========================================

# Habilita el sistema de followup automático (24h después de inactividad)
# Envía templates de WhatsApp para reactivar conversaciones
FOLLOWUP_ENABLED=true

# Horas de espera antes de enviar followup (default: 24)
FOLLOWUP_DELAY_HOURS=24

# Habilita recordatorios de citas programadas
# Envía recordatorio 24h antes y seguimiento 24h después de la cita
APPOINTMENT_REMINDERS_ENABLED=true

# ========================================
# HUBSPOT INTEGRATION
# ========================================

# Token de Private App (generado desde: Private Apps > Create app)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID del Pipeline de ventas
HUBSPOT_PIPELINE_ID=0000000000

# ID del Deal Stage (Nuevo lead)
HUBSPOT_DEAL_STAGE=0000000000

# Token Admin API (para endpoints administrativos)
ADMIN_API_KEY=your-secure-random-key-here

# Pipeline de Redes Sociales
HUBSPOT_PIPELINE_REDES_SOCIALES_ID=0000000000
HUBSPOT_REDES_STAGE_NUEVO=0000000000

# ========================================
# BUNNY.NET CDN (para almacenamiento multimedia)
# ========================================

# Nombre del Storage Zone en Bunny.net
BUNNY_STORAGE_ZONE_NAME=inmobiliaria-media

# API Key/Password del Storage Zone (obtenida del dashboard de Bunny.net)
# Formato: UUID estándar (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
BUNNY_STORAGE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Pull Zone URL (donde se sirve el contenido desde el CDN - debe incluir https://)
BUNNY_PULL_ZONE_URL=https://inmobiliaria-media.b-cdn.net

# Endpoint del Storage (incluye región: ny, la, sg, etc.)
# Opciones: ny.storage.bunnycdn.com, la.storage.bunnycdn.com, sg.storage.bunnycdn.com
BUNNY_STORAGE_ENDPOINT=ny.storage.bunnycdn.com

# Región de Bunny (solo referencial, si es diferente al endpoint)
BUNNY_REGION=ny

# ========================================
# MONGODB (para histórico de panel de asesores)
# ========================================

# URL interna de MongoDB (para conexión dentro de Railway)
MONGO_URL=mongodb://mongo:password@mongodb.railway.internal:27017

# URL pública de MongoDB (para acceso externo con proxy)
MONGO_PUBLIC_URL=mongodb://mongo:password@shortline.proxy.rlwy.net:45260

# ========================================
# NOTAS IMPORTANTES:
# - El archivo .env está protegido por .gitignore
# - Las API keys son sensibles - no las compartas
# - Rota tus keys si sospechas compromiso
# - Configura el webhook en Twilio: https://tu-dominio.railway.app/whatsapp/webhook
# ========================================
