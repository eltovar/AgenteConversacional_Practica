			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 200', () => pm.response.to.have.status(200));",
							"",
							"pm.test('Mensaje enviado con éxito', () => {",
							"    const json = pm.response.json();",
							"    pm.expect(json.status).to.eql('success');",
							"});",
							"",
							"pm.test('Tiene message_sid de Twilio', () => {",
							"    const json = pm.response.json();",
							"    pm.expect(json.message_sid).to.match(/^SM/);",
							"});",
							"",
							"pm.test('Sofia fue pausada', () => {",
							"    const json = pm.response.json();",
							"    pm.expect(json.sofia_paused).to.be.true;",
							"});",
