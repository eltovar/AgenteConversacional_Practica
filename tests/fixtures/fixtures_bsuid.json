{
  "description": "Fixtures anonimizados/sinteticos para forensia BSUID. No contienen PII real.",
  "cases": [
    {
      "name": "telefono_whatsapp_normal",
      "payload": {
        "From": "whatsapp:+573001234567",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_PHONE"
      },
      "expected_current_branch": "phone_valid"
    },
    {
      "name": "bsuid_rechazado_por_validacion_colombiana",
      "payload": {
        "From": "whatsapp:CO.899759302823042",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_BSUID_REJECTED"
      },
      "expected_current_branch": "invalid_phone_not_mobile_colombian"
    },
    {
      "name": "bsuid_con_waid_en_channel_metadata",
      "payload": {
        "From": "whatsapp:CO.899759302823042",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_BSUID_WAID",
        "ChannelMetadata": {
          "data": {
            "context": {
              "ProfileName": "Nombre Anonimo",
              "WaId": "573001234567"
            }
          }
        }
      },
      "expected_current_branch": "bsuid_still_uses_from_and_rejects"
    },
    {
      "name": "bsuid_sin_waid",
      "payload": {
        "From": "whatsapp:CO.1286151580210926",
        "Body": "Info",
        "MessageSid": "SM_FIXTURE_BSUID_NO_WAID",
        "ChannelMetadata": {
          "data": {
            "context": {
              "ProfileName": "Nombre Anonimo"
            }
          }
        }
      },
      "expected_current_branch": "invalid_phone_not_mobile_colombian"
    },
    {
      "name": "username_whatsapp",
      "payload": {
        "From": "whatsapp:cliente.usuario",
        "Username": "cliente.usuario",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_USERNAME"
      },
      "expected_fixed_branch": "request_contact_info_without_phone_persistence"
    },
    {
      "name": "telefono_extranjero_e164",
      "payload": {
        "From": "whatsapp:+14155552671",
        "Body": "Hello",
        "MessageSid": "SM_FIXTURE_FOREIGN_PHONE"
      },
      "expected_fixed_branch": "phone_valid_normal_flow"
    },
    {
      "name": "unknown_vacio",
      "payload": {
        "From": "",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_UNKNOWN"
      },
      "expected_current_branch": "empty_phone"
    },
    {
      "name": "entrada_larga_podria_fabricar_telefono",
      "payload": {
        "From": "whatsapp:CO.999993001234567",
        "Body": "Hola",
        "MessageSid": "SM_FIXTURE_FABRICATED_PHONE"
      },
      "expected_current_branch": "fabricated_phone_risk"
    }
  ]
}
